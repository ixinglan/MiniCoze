# ===== AI Workshop 一键部署环境变量示例 =====
# 复制为 .env 并填入真实值（.env 会被 compose 自动读取；不要提交到仓库）
# 用法：cp docker/.env.example .env && vim .env

# DeepSeek 对话模型（必填）
AI_DEEPSEEK_API_KEY=

# 阿里云 DashScope（qwen-vl-max 图片理解 / 通义万相文生图，必填）
AI_DASHSCOPE_API_KEY=

# 可选覆盖（不设则用 compose 里的默认值，指向宿主机已有服务）
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=123456
# RAG_VECTORSTORE_MILVUS_HOST=host.docker.internal
# SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# LANGFUSE_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel/v1/traces
