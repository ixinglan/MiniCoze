<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.ai</groupId>
    <artifactId>ai-workshop-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AI Workshop Parent</name>
    <description>综合知识库 + Agent 工作台（多模块父 POM）</description>

    <!-- ===== 子模块列表 ===== -->
    <modules>
        <module>ai-workshop</module>
        <module>mcp-nacos-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- 三件套版本需严格对应，详见 https://java2ai.com/docs/versions -->
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>
        <spring-ai-alibaba-extensions.version>1.1.2.1</spring-ai-alibaba-extensions.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <!-- ===== BOM 统一版本管理（子模块继承，无需重复声明） ===== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba-extensions.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 强阶段 7：nacos-mcp-client 不在 SAA/BOM 管理范围，需显式声明版本 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-starter-nacos-mcp-client</artifactId>
                <version>1.0.0.2</version>
            </dependency>
            <!-- 强阶段 7：Nacos Discovery（SCA 2025.0.0.0 适配 Boot 3.5.x，含 Nacos 3.0.3） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
                <version>2025.0.0.0</version>
            </dependency>
            <!-- 强制 mybatis-spring 版本：mybatis-plus-boot-starter 默认锁了 2.1.2（Spring 5 时代），
                 而 Spring Boot 3.5 用 Spring 6.2，要求 factoryBeanObjectType 为 Class 类型，
                 2.1.2 写入的是 String 会导致 Mapper 注册失败。3.0.x 已适配 Spring 6.2。 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>3.0.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ===== 所有子模块共享的基础依赖 ===== -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
